<?xml version="1.0"?>
<materialx version="1.39">
  <flake3d name="flake3d" type="multioutput">
    <input name="size" type="float" value="0.01" />
    <input name="roughness" type="float" value="0.1" />
    <input name="coverage" type="float" value="0.5" />
  </flake3d>
  <convert name="shader_flake3d_id" type="surfaceshader">
    <input name="in" type="integer" nodename="flake3d" output="id" />
  </convert>
  <surfacematerial name="material_flake3d_id" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_flake3d_id" />
  </surfacematerial>
  <convert name="shader_flake3d_rand" type="surfaceshader">
    <input name="in" type="float" nodename="flake3d" output="rand" />
  </convert>
  <surfacematerial name="material_flake3d_rand" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_flake3d_rand" />
  </surfacematerial>
  <convert name="shader_flake3d_presence" type="surfaceshader">
    <input name="in" type="float" nodename="flake3d" output="presence" />
  </convert>
  <surfacematerial name="material_flake3d_presence" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_flake3d_presence" />
  </surfacematerial>
  <convert name="shader_flake3d_flakenormal" type="surfaceshader">
    <input name="in" type="vector3" nodename="flake3d" output="flakenormal" />
  </convert>
  <surfacematerial name="material_flake3d_flakenormal" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="shader_flake3d_flakenormal" />
  </surfacematerial>
</materialx>
